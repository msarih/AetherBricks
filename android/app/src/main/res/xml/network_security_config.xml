<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Autorise les connexions WebSocket/HTTP en clair sur le réseau local (Wi-Fi) et Tailscale -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
